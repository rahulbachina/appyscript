{
  "name": "appyscript",
  "version": "1.0.0",
  "description": "The first English-first programming language for educational robotics. Compile to ESP32, Pico, micro:bit, Arduino, and CircuitPython.",
  "author": "Applaa <rahul.bachin@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rahulbachina/appyscript",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulbachina/appyscript.git"
  },
  "keywords": [
    "robotics",
    "education",
    "kids",
    "appyscript",
    "esp32",
    "arduino",
    "micropython",
    "pico",
    "microbit",
    "compiler",
    "language"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "appyscript": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/test/compiler.test.js",
    "mcp": "node dist/mcp/server.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "release:dry": "npm publish --dry-run",
    "publish:npm": "npm run build && npm test && npm publish",
    "serve:playground": "npx serve playground -p 3000"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "bugs": {
    "url": "https://github.com/rahulbachina/appyscript/issues"
  },
  "files": [
    "dist",
    "vscode",
    "runtime",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}