{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AppyScript",
  "scopeName": "source.appyscript",
  "fileTypes": ["appy"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#block-keywords" },
    { "include": "#control-keywords" },
    { "include": "#action-keywords" },
    { "include": "#sensor-keywords" },
    { "include": "#trigger-keywords" },
    { "include": "#expression-keywords" },
    { "include": "#variable-keywords" },
    { "include": "#boolean-literals" },
    { "include": "#operators" },
    { "include": "#units" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.appyscript",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.appyscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.appyscript", "match": "\\\\." }
      ]
    },
    "strings-single": {
      "name": "string.quoted.single.appyscript",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.appyscript", "match": "\\\\." }
      ]
    },
    "numbers": {
      "name": "constant.numeric.appyscript",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    "block-keywords": {
      "name": "keyword.control.block.appyscript",
      "match": "(?i)\\b(when|on|forever|define|end|every)\\b"
    },
    "control-keywords": {
      "name": "keyword.control.flow.appyscript",
      "match": "(?i)\\b(if|else|otherwise|then|repeat|times|while|until|match|case|default)\\b"
    },
    "action-keywords": {
      "name": "support.function.appyscript",
      "match": "(?i)\\b(move|turn|spin|stop|say|play|show|wait|send|do|remember)\\b"
    },
    "sensor-keywords": {
      "name": "variable.language.sensor.appyscript",
      "match": "(?i)\\b(distance|light|temperature|touch|acceleration)\\b"
    },
    "trigger-keywords": {
      "name": "keyword.other.trigger.appyscript",
      "match": "(?i)\\b(pressed|released|shaken|tilted|received|receives|starts|button_a|button_b|start|timer)\\b"
    },
    "expression-keywords": {
      "name": "constant.language.expression.appyscript",
      "match": "(?i)\\b(happy|sad|thinking|excited|angry|alert|sleep|calm|confused|dizzy)\\b"
    },
    "variable-keywords": {
      "name": "keyword.other.variable.appyscript",
      "match": "(?i)\\b(let|set|to|change|by|text|number)\\b"
    },
    "direction-keywords": {
      "name": "constant.language.direction.appyscript",
      "match": "(?i)\\b(forward|backward|back|left|right|at|for|full|slow|fast|half|speed)\\b"
    },
    "boolean-literals": {
      "name": "constant.language.boolean.appyscript",
      "match": "(?i)\\b(yes|no|true|false)\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.logical.appyscript", "match": "(?i)\\b(and|or|not)\\b" },
        { "name": "keyword.operator.comparison.appyscript", "match": "<=|>=|==|!=|<|>" },
        { "name": "keyword.operator.arithmetic.appyscript", "match": "[+\\-*/]" },
        { "name": "keyword.operator.assignment.appyscript", "match": "=" }
      ]
    },
    "units": {
      "name": "keyword.other.unit.appyscript",
      "match": "(?<=[0-9])(cm|ms|s|m|%|°)"
    },
    "identifiers": {
      "name": "variable.other.appyscript",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  }
}
